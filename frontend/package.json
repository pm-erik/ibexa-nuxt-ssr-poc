    "dev:editor": "vite build -c vite.editor.config.ts --mode development --watch"
  },
  "dependencies": {
    "nuxt": "^4.4.4",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.2",
    "vite-plugin-vue-devtools": "^7.7.0"
  }
}
